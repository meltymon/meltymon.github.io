---
const { lang, nav } = Astro.props;
const isEnglish = lang === "en";
---

<header class="site-header">
  <a class="brand" href={isEnglish ? "/en/" : "/"} aria-label="meltymon.org home">
    <span class="brand-mark">m<span>.</span></span>
    <span class="brand-name">meltymon<span>.org</span></span>
  </a>

  <nav class="main-nav" aria-label={isEnglish ? "Main navigation" : "Hauptnavigation"}>
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="language-switch" aria-label={isEnglish ? "Language" : "Sprache"}>
    <a href="/" lang="de" aria-current={!isEnglish ? "page" : undefined}>DE</a>
    <span aria-hidden="true">/</span>
    <a href="/en/" lang="en" aria-current={isEnglish ? "page" : undefined}>EN</a>
  </div>
</header>
