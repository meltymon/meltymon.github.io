---
const { lang, nav, alternateHref } = Astro.props;
const isEnglish = lang === "en";
---

<header class="site-header">
  <a class="brand" href={isEnglish ? "/en/" : "/"} aria-label="meltymon.org home">
    <span class="brand-mark">m<span>.</span></span>
    <span class="brand-name">meltymon<span>.org</span></span>
  </a>

  <nav class="main-nav" aria-label={isEnglish ? "Main navigation" : "Hauptnavigation"}>
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="header-tools">
    <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
      <span aria-hidden="true">⌘</span>
      <span data-theme-label>{isEnglish ? "Cyberpunk mode" : "Cyberpunk-Modus"}</span>
    </button>
    <div class="language-switch" aria-label={isEnglish ? "Language" : "Sprache"}>
      <a href={isEnglish ? alternateHref : Astro.url.pathname} lang="de" aria-current={!isEnglish ? "page" : undefined}>DE</a>
      <span aria-hidden="true">/</span>
      <a href={isEnglish ? Astro.url.pathname : alternateHref} lang="en" aria-current={isEnglish ? "page" : undefined}>EN</a>
    </div>
  </div>
</header>
