---
import SiteLayout from "../layouts/SiteLayout.astro";

const content = {
  title: "Datenschutzerklärung | meltymon.org",
  description: "Informationen zur Verarbeitung personenbezogener Daten beim Besuch von meltymon.org.",
  nav: [],
  footer: { note: "Mit Sorgfalt gebaut. Inhalte und Projekte werden laufend überprüft.", imprint: "Impressum" },
