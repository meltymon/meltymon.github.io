---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EasterEggs from "../components/EasterEggs.astro";

const { lang, content } = Astro.props;
const isEnglish = lang === "en";
const pathname = Astro.url.pathname;
const pageType = pathname === "/datenschutz/" || pathname === "/en/privacy/"
  ? "privacy"
  : pathname === "/impressum/" || pathname === "/en/legal-notice/"
    ? "legal"
    : "home";
const germanPath = pageType === "privacy"
  ? "/datenschutz/"
  : pageType === "legal"
    ? "/impressum/"
    : "/";
const englishPath = pageType === "privacy"
  ? "/en/privacy/"
  : pageType === "legal"
    ? "/en/legal-notice/"
    : "/en/";
const germanUrl = new URL(germanPath, Astro.site);
const englishUrl = new URL(englishPath, Astro.site);
const canonical = isEnglish ? englishUrl : germanUrl;
const alternateHref = isEnglish ? germanUrl.pathname : englishUrl.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={content.description} />
    <meta name="theme-color" content="#090d12" />
    <title>{content.title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={germanUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={germanUrl} />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("meltymon-theme");
        if (savedTheme === "cyberpunk") document.documentElement.dataset.theme = "cyberpunk";
      } catch {}
    </script>
    <script>
      import "../scripts/theme-toggle.js";
      import "../scripts/easter-eggs.js";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isEnglish ? "Skip to content" : "Zum Inhalt springen"}</a>
    <div class="ambient-grid" aria-hidden="true"></div>
    <div class="crt-overlay" aria-hidden="true"></div>
    <SiteHeader lang={lang} nav={content.nav} alternateHref={alternateHref} />
    <aside class="cyberpunk-sidebar" aria-label={isEnglish ? "Terminal navigation" : "Terminalnavigation"}>
      <h2>$ meltymon-cli.sh</h2>
      <nav>{content.nav.map((item, index) => <a href={item.href}><span>{String(index + 1).padStart(2, "0")}</span> {item.label}</a>)}</nav>
      <p class="sidebar-status">SYS.STATUS: ONLINE</p>
    </aside>
    <main id="main-content">
      <slot />
    </main>
    <EasterEggs lang={lang} />
    <SiteFooter lang={lang} footer={content.footer} />
  </body>
</html>
