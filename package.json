    "changelog": "node scripts/generate-changelog.js",
    "changelog:write": "node scripts/generate-changelog.js --write",
    "project-metadata": "node scripts/generate-github-metadata.js",
    "project-metadata:write": "node scripts/generate-github-metadata.js"
  },
  "dependencies": {
    "astro": "7.4.13"
  }
}
