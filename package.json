{
  "name": "meltymon-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run project-metadata:write && npm run validate && npm run changelog:write && astro build",
    "preview": "astro preview",
